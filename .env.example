# MongoDB
# Local:
# MONGODB_URI=mongodb://127.0.0.1:27017/storm-and-johnson

# Atlas SRV (needs working DNS SRV lookups):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/storm-and-johnson?retryWrites=true&w=majority

# Atlas STANDARD connection string (use this if you see querySrv ECONNREFUSED):
# In Atlas → Connect → Drivers → choose "Node.js" → copy the non-srv host list format, e.g.
# MONGODB_URI=mongodb://USER:PASSWORD@ac-xxxx-shard-00-00.xxxxx.mongodb.net:27017,ac-xxxx-shard-00-01.xxxxx.mongodb.net:27017,ac-xxxx-shard-00-02.xxxxx.mongodb.net:27017/storm-and-johnson?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority

MONGODB_URI=mongodb://127.0.0.1:27017/storm-and-johnson

# Auth (change in production)
JWT_SECRET=storm-johnson-super-secret-change-me-in-production
ADMIN_EMAIL=admin@stormandjohnson.com
ADMIN_PASSWORD=Admin@12345

# Email (Gmail app password or SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=stormandjohnsonltd@gmail.com
SMTP_PASS=
EMAIL_FROM=Storm & Johnson <stormandjohnsonltd@gmail.com>
EMAIL_TO=stormandjohnsonltd@gmail.com

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=2349041140745

# Firebase Storage (Admin product image uploads)
# From Firebase Console → Project settings → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: server-side Firebase uploads (recommended — avoids browser network blocks)
# Firebase Console → Project settings → Service accounts → Generate new private key
# Paste the full JSON as one line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
